# Application
HCA_APP_ENV=development
HCA_API_HOST=127.0.0.1
HCA_API_PORT=8000
HCA_LOG_LEVEL=info
HCA_API_V1_PREFIX=/api/v1
HCA_MAX_UPLOAD_BYTES=20971520

# PostgreSQL
# Gerçek kullanıcı adı ve parolayı yalnızca yerel .env dosyasına yazın.
HCA_DATABASE_URL=postgresql://exam_app:change_me@localhost:5432/exam_assessment
HCA_DATABASE_POOL_SIZE=10
HCA_DATABASE_MAX_OVERFLOW=20

# Authentication
# Production ortamında uzun ve rastgele bir secret manager değeri kullanın.
HCA_JWT_SECRET_KEY=replace_with_a_long_random_secret
HCA_JWT_ALGORITHM=HS256
HCA_ACCESS_TOKEN_EXPIRE_MINUTES=15
HCA_REFRESH_TOKEN_EXPIRE_DAYS=30

# Queue / background jobs
HCA_REDIS_URL=redis://localhost:6379/0

# Private S3-compatible object storage
HCA_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
HCA_OBJECT_STORAGE_REGION=us-east-1
HCA_OBJECT_STORAGE_BUCKET=exam-papers-local
HCA_OBJECT_STORAGE_ACCESS_KEY_ID=change_me
HCA_OBJECT_STORAGE_SECRET_ACCESS_KEY=change_me
HCA_OBJECT_STORAGE_USE_SSL=false

# OCR / ML
HCA_MODEL_VERSION=untrained
HCA_REVIEW_CONFIDENCE_THRESHOLD=0.85

# Mobile development origins; production values must be restricted.
HCA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
